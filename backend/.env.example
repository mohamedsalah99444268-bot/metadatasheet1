OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=1024
OLLAMA_TEMPERATURE=0.1
OLLAMA_KEEP_ALIVE=5m
DATASHEET_SEARCH_TIMEOUT_SECONDS=15
DATASHEET_DOWNLOAD_TIMEOUT_SECONDS=30
DATASHEET_MAX_DOWNLOAD_BYTES=157286400
OFFICIAL_DATASHEET_DOMAINS=
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=6
RAG_MIN_SCORE=0.15
CHROMA_PERSIST_DIR=backend/rag_chroma
RAG_INDEX_VERSION=v2
VECTOR_BACKEND=chroma

# Laisser vide pour conserver SQLite. Exemple PostgreSQL :
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartdatasheet
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Activer en production. Le premier compte admin peut aussi être bootstrapé par variables d'environnement.
AUTH_ENABLED=false
AUTH_TOKEN_TTL_SECONDS=86400
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

WORKER_ENABLED=true
WORKER_POLL_SECONDS=2

# OCR local via Tesseract (binaire système requis).
OCR_ENABLED=true
